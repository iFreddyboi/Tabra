# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/tabra?sslmode=require

# Auth (NextAuth / Auth.js)
NEXTAUTH_SECRET=change-me-32-chars-minimum-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (use test keys locally: sk_test_... / pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ANNUAL=price_...    # $19.99/year recurring
STRIPE_PRICE_TRIP=price_...      # $2.99 one-time

# Email (Resend — resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=hello@tabra.app

# Vercel Blob (for receipt uploads)
BLOB_READ_WRITE_TOKEN=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
